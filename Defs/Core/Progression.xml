<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================== Arcane crystal: the resource that fuels awakening and ascension ===================== -->
  <ThingDef ParentName="AA_ArcaneItemBase">
    <defName>AA_ArcaneCrystal</defName>
    <label>arcane crystal</label>
    <description>A shard of crystallised ley energy that hums faintly in the hand. Arcane crystals are needed to scribe grimoires of awakening and the sigils that let mages ascend to higher circles.\n\nFound in ley crystal veins in mountains, deep underground, in the stock of exotic traders, and on the bodies of fallen enemy mages.</description>
    <graphicData>
      <texPath>ArcanumAscendant/Items/ArcaneCrystal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>14</MarketValue>
      <Mass>0.25</Mass>
      <Flammability>0</Flammability>
      <Beauty>4</Beauty>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <deepCommonality>0.5</deepCommonality>
    <deepCountPerPortion>10</deepCountPerPortion>
    <deepLumpSizeRange>3~8</deepLumpSizeRange>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(170,120,255,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

  <ThingDef>
    <defName>AA_MineableLeyCrystal</defName>
    <label>ley crystal vein</label>
    <description>Rock shot through with violet arcane crystal where a ley line runs close to the surface. Mine it to extract arcane crystals.</description>
    <thingClass>Mineable</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <neverMultiSelect>true</neverMultiSelect>
    <rotatable>false</rotatable>
    <saveCompressible>true</saveCompressible>
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <blockLight>true</blockLight>
    <mineable>true</mineable>
    <drawerType>MapMeshOnly</drawerType>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <graphicData>
      <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(78,70,90)</color>
      <colorTwo>(190,130,255)</colorTwo>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Rock</li>
        <li>MapEdge</li>
      </linkFlags>
    </graphicData>
    <statBases>
      <MaxHitPoints>1800</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <building>
      <isInert>true</isInert>
      <isResourceRock>true</isResourceRock>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <mineableThing>AA_ArcaneCrystal</mineableThing>
      <mineableYield>6</mineableYield>
      <mineableScatterCommonality>0.1</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>3~7</mineableScatterLumpSizeRange>
      <veinMineable>true</veinMineable>
    </building>
  </ThingDef>

  <!-- ===================== Ascension sigils (the arcane equivalent of a neuroformer) ===================== -->
  <ThingDef ParentName="AA_ArcaneItemBase">
    <defName>AA_Sigil_SecondCircle</defName>
    <label>sigil of the second circle</label>
    <description>A disc of arcane glass etched with a second-circle seal. A mage who has reached level 6 can shatter it to break through to the Second Circle: their level cap rises by six, and they gain three skill points and an attribute point at once. Reaching the Second Circle also unlocks the mage's subclass.</description>
    <graphicData>
      <texPath>ArcanumAscendant/Items/Sigil2</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>5</stackLimit>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>700</MarketValue>
      <Mass>0.4</Mass>
      <Flammability>0</Flammability>
      <Beauty>6</Beauty>
      <DeteriorationRate>0.5</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Shatter {0_label} and ascend</useLabel>
        <useDuration>900</useDuration>
      </li>
      <li Class="ArcanumAscendant.CompProperties_UseEffectAscend">
        <circle>2</circle>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>

