  <!-- ===================== Recipes ===================== -->
  <RecipeDef ParentName="AA_ArcaneRecipeBase">
    <defName>AA_Make_Sigil2</defName>
    <label>etch sigil of the second circle</label>
    <description>Etch a sigil of the second circle.</description>
    <jobString>Etching a sigil.</jobString>
    <workAmount>8000</workAmount>
    <ingredients>
      <li>
        <filter><thingDefs><li>AA_ArcaneCrystal</li></thingDefs></filter>
        <count>12</count>
      </li>
      <li>
        <filter><thingDefs><li>Silver</li></thingDefs></filter>
        <count>80</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>AA_ArcaneCrystal</li>
        <li>Silver</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <AA_Sigil_SecondCircle>1</AA_Sigil_SecondCircle>
    </products>
    <skillRequirements>
      <Intellectual>6</Intellectual>
    </skillRequirements>
    <researchPrerequisite>AA_Arcanology</researchPrerequisite>
  </RecipeDef>

