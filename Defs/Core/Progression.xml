  <!-- ===================== Study ===================== -->
  <JobDef>
    <defName>AA_ArcaneStudy</defName>
    <driverClass>ArcanumAscendant.JobDriver_ArcaneStudy</driverClass>
    <reportString>studying the arcane.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JoyKindDef>
    <defName>AA_ArcaneStudy</defName>
    <label>arcane study</label>
  </JoyKindDef>

  <JobDef>
    <defName>AA_ArcaneStudyJoy</defName>
    <driverClass>ArcanumAscendant.JobDriver_ArcaneStudy</driverClass>
    <reportString>studying the arcane.</reportString>
    <joyDuration>4000</joyDuration>
    <joyMaxParticipants>1</joyMaxParticipants>
    <joyKind>AA_ArcaneStudy</joyKind>
    <joySkill>Intellectual</joySkill>
    <joyXpPerTick>0.002</joyXpPerTick>
  </JobDef>

  <JoyGiverDef>
    <defName>AA_ArcaneStudy</defName>
    <giverClass>ArcanumAscendant.JoyGiver_ArcaneStudy</giverClass>
    <baseChance>3.5</baseChance>
    <thingDefs>
      <li>AA_ArcaneAltar</li>
    </thingDefs>
    <jobDef>AA_ArcaneStudyJoy</jobDef>
    <joyKind>AA_ArcaneStudy</joyKind>
    <requiredCapacities>
      <li>Sight</li>
    </requiredCapacities>
  </JoyGiverDef>

  <!-- ===================== Spontaneous awakening ===================== -->
  <IncidentDef>
    <defName>AA_LatentAwakening</defName>
    <label>latent awakening</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>ArcanumAscendant.IncidentWorker_LatentAwakening</workerClass>
    <baseChance>0.25</baseChance>
    <minRefireDays>45</minRefireDays>
    <earliestDay>20</earliestDay>
    <letterLabel>Latent awakening: {PAWN_labelShort}</letterLabel>
    <letterText>{PAWN_labelShort}'s latent gift has woken on its own. Without a grimoire or a single hour of study, {PAWN_pronoun} can feel the weave of magic under the world.\n\n{PAWN_labelShort} can now awaken and choose an arcane class. Select {PAWN_objective} and click "Awaken magic".</letterText>
    <letterDef>PositiveEvent</letterDef>
  </IncidentDef>

</Defs>
