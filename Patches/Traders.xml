<?xml version="1.0" encoding="utf-8"?>
<!-- Adds arcane crystals, grimoires and early sigils to trader stock. Each operation is skipped silently if
     another mod has removed the trader. -->
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/TraderKindDef[defName="Orbital_Exotic" or defName="Caravan_Outlander_Exotic"]/stockGenerators</xpath>
    <success>Always</success>
    <value>
      <li Class="StockGenerator_SingleDef">
        <thingDef>AA_ArcaneCrystal</thingDef>
        <countRange>20~60</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>AA_Grimoire</thingDef>
        <countRange>-1~1</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>AA_Sigil_Circle2</thingDef>
        <countRange>-2~1</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>AA_Sigil_Circle3</thingDef>
        <countRange>-3~1</countRange>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/TraderKindDef[defName="Base_Outlander_Standard" or defName="Base_Neolithic_Standard" or defName="Caravan_Neolithic_ShamanMerchant"]/stockGenerators</xpath>
    <success>Always</success>
    <value>
      <li Class="StockGenerator_SingleDef">
        <thingDef>AA_ArcaneCrystal</thingDef>
        <countRange>8~25</countRange>
      </li>
    </value>
  </Operation>
</Patch>
